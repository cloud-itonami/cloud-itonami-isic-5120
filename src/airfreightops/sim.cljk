(ns airfreightops.sim
  "Demo driver -- `kbb -M:run`. Walks a clean shipment-record logging
  request through intake -> advise -> govern -> decide -> approval ->
  commit at phase 1 (assisted-logging, always approval), then re-runs the
  same op at phase 3 (supervised-auto, clean + high confidence ->
  auto-commit), then a ground-operation-scheduling request and a
  low-cost maintenance-order coordination naming a verified contractor
  (both auto-commit clean at phase 3), then a high-cost maintenance-order
  (ALWAYS escalates regardless of phase), then a safety-concern flag
  (ALWAYS escalates, at any phase -- approve, then commit), then
  HARD-hold scenarios: an unregistered facility, a facility registered
  but not yet verified, a maintenance-order naming an unverified
  contractor, a proposal whose own `:effect` is not `:propose`, and a
  proposal that has drifted into the permanently-excluded flight-
  operations/airworthiness-clearance-finalization scope."
  (:require [langgraph.graph :as g]
            [airfreightops.advisor :as advisor]
            [airfreightops.store :as store]
            [airfreightops.operation :as op]))

(defn- exec-op [actor tid request context]
  (g/run* actor {:request request :context context} {:thread-id tid}))

(defn- approve! [actor tid]
  (g/run* actor {:approval {:status :approved :by "ground-logistics-coordinator-1"}} {:thread-id tid :resume? true}))

(defn -main [& _]
  (let [db (store/seed-db)
        coordinator-phase-1 {:actor-id "coord-1" :actor-role :ground-logistics-coordinator :phase 1}
        coordinator-phase-3 {:actor-id "coord-1" :actor-role :ground-logistics-coordinator :phase 3}
        actor (op/build db)]

    (println "== log-shipment-record facility-1 (phase 1, escalates -- human approves) ==")
    (let [r (exec-op actor "t1" {:op :log-shipment-record :facility-id "facility-1"
                                  :patch {:awb-number "020-12345675" :piece-count 42 :gross-weight-kg 3200 :dg-class "none"}} coordinator-phase-1)]
      (println r)
      (println "-- human ground-logistics coordinator approves --")
      (println (approve! actor "t1")))

    (println "\n== log-shipment-record facility-1 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t2" {:op :log-shipment-record :facility-id "facility-1"
                                  :patch {:awb-number "020-12345699" :piece-count 30 :gross-weight-kg 1800 :dg-class "none"}} coordinator-phase-3))

    (println "\n== schedule-ground-operation facility-1 (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t3" {:op :schedule-ground-operation :facility-id "facility-1"
                                  :patch {:dock "dock-4" :eta "2026-07-20T06:00:00Z" :etd "2026-07-20T18:00:00Z"}} coordinator-phase-3))

    (println "\n== coordinate-maintenance-order facility-1, low cost, verified contractor (phase 3, clean -- auto-commits) ==")
    (println (exec-op actor "t4" {:op :coordinate-maintenance-order :facility-id "facility-1"
                                  :patch {:item "routine loader inspection" :estimated-cost 1200.0
                                          :contractor-id "contractor-1"}} coordinator-phase-3))

    (println "\n== coordinate-maintenance-order facility-1, HIGH cost (ALWAYS escalates, even at phase 3) ==")
    (let [r (exec-op actor "t5" {:op :coordinate-maintenance-order :facility-id "facility-1"
                                 :patch {:item "main ULD loader overhaul" :estimated-cost 42000.0
                                         :contractor-id "contractor-1"}} coordinator-phase-3)]
      (println r)
      (println "-- human ground-logistics coordinator reviews & approves --")
      (println (approve! actor "t5")))

    (println "\n== flag-safety-concern facility-1 (ALWAYS escalates, even at phase 3) ==")
    (let [r (exec-op actor "t6" {:op :flag-safety-concern :facility-id "facility-1"
                                 :patch {:concern "dangerous-goods declaration mismatch on AWB 020-12345675, possible weight discrepancy" :confidence 0.92}} coordinator-phase-3)]
      (println r)
      (println "-- human operating crew/cargo-safety officer reviews & approves --")
      (println (approve! actor "t6")))

    (println "\n== log-shipment-record facility-99 (unregistered facility -> HARD hold) ==")
    (println (exec-op actor "t7" {:op :log-shipment-record :facility-id "facility-99"
                                  :patch {:piece-count 0}} coordinator-phase-3))

    (println "\n== log-shipment-record facility-3 (registered but unverified -> HARD hold) ==")
    (println (exec-op actor "t8" {:op :log-shipment-record :facility-id "facility-3"
                                  :patch {:piece-count 10}} coordinator-phase-3))

    (println "\n== coordinate-maintenance-order facility-1, contractor-2 unverified (-> HARD hold) ==")
    (println (exec-op actor "t9" {:op :coordinate-maintenance-order :facility-id "facility-1"
                                  :patch {:item "conveyor belt survey" :estimated-cost 3000.0
                                          :contractor-id "contractor-2"}} coordinator-phase-3))

    (println "\n== schedule-ground-operation facility-1, advisor attempts direct actuation (:effect :commit) -> HARD hold ==")
    (let [actor-direct (op/build db {:advisor (reify advisor/Advisor
                                                (-advise [_ _ req]
                                                  (assoc (advisor/infer nil req) :effect :commit)))})]
      (println (exec-op actor-direct "t10" {:op :schedule-ground-operation :facility-id "facility-1"
                                           :patch {:dock "dock-2" :eta "2026-07-22T08:00:00Z"}} coordinator-phase-3)))

    (println "\n== log-shipment-record facility-1, advisor drifts into flight-operations/airworthiness-clearance-finalization scope -> HARD hold, permanent ==")
    (println (exec-op actor "t11" {:op :log-shipment-record :facility-id "facility-1"
                                   :out-of-scope? true
                                   :patch {}} coordinator-phase-3))

    (println "\n== audit ledger ==")
    (doseq [f (store/ledger db)] (println f))

    (println "\n== committed coordination log ==")
    (doseq [r (store/coordination-log db)] (println r))))
